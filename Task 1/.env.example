# Local-only credentials for the Compose MinIO instance. Change these outside local development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=rag-documents

# Host ports. The API listens on 0.0.0.0:8000 in the container; change RAG_API_PORT only if 8000 is taken.
RAG_API_PORT=8000
POSTGRES_PORT=15432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
