# Copy to .env: docker compose and make read it. Every variable here is optional; an empty or
# missing one falls back to the default shown. Variables not listed keep the defaults of app/core/config.py.

# --- Storage ----------------------------------------------------------------------------------
# Local-only credentials for the Compose MinIO instance. Change these outside local development.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=rag-documents

# --- Host ports ---------------------------------------------------------------------------------
# The API listens on 0.0.0.0:8000 in the container; change RAG_API_PORT only if 8000 is taken.
RAG_API_PORT=8000
POSTGRES_PORT=15432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# --- Models -------------------------------------------------------------------------------------
# make models downloads exactly these, and the containers load the same ones.
# RETRIEVER_MODEL must give 1024-d vectors (the vector column); another size needs a migration.
RETRIEVER_MODEL=deepvk/USER-bge-m3
RERANKER_MODEL=qilowoq/bge-reranker-v2-m3-en-ru
LLM_MODEL=qwen3.8:27b-mtp-q4_K_M

# --- Throughput ---------------------------------------------------------------------------------
# Chunks per GPU batch when a document is embedded, and query-chunk pairs per reranker batch.
EMBEDDING_BATCH_SIZE=256
RERANKER_BATCH_SIZE=64
# Generations sent to Ollama at once; it also sets OLLAMA_NUM_PARALLEL, so the two always match.
# Over the cap a query waits LLM_QUEUE_TIMEOUT seconds for a slot, then gets the citations without a summary.
LLM_MAX_CONCURRENCY=4
LLM_QUEUE_TIMEOUT=30
# Seconds per LLM call before it counts as failed.
OLLAMA_TIMEOUT=120

# --- Generation ---------------------------------------------------------------------------------
# A low temperature keeps the answer close to the retrieved text.
LLM_TEMPERATURE=0.1
# Context window in tokens: the prompt and five 1200-character chunks take about 3-4k.
LLM_NUM_CTX=16384
# Longest answer in tokens; a longer one is cut and logged as a warning.
LLM_NUM_PREDICT=2048

# --- Logging ------------------------------------------------------------------------------------
# DEBUG also logs query texts, reranker scores and token counts: keep INFO in production.
LOG_LEVEL=INFO
