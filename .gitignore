# Secrets and local settings: commit .env.example instead
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tests and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs (written when LOG_DIR is set)
logs/
*.log

# Local model caches, if models are downloaded outside Docker
.cache/

# Editors and OS
.vscode/
.idea/
.DS_Store

# === Alembic миграции (сами миграции оставим, но игнорируем pycache) ===
alembic/__pycache__/

